# ===== EyeSafe - Configuración =====
# Copia este archivo a .env y ajusta los valores.

# URL RTSP, índice de cámara (0, 1...) o ruta a un video
CAMERA_SOURCE=rtsp://usuario:contraseña@192.168.1.100:554/stream1

# Nombre de la zona vigilada (se usa como contexto del evento)
CAMERA_ZONE=portón_norte

# Confianza mínima para aceptar una detección (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.60

# Franja horaria de actividad normal (HH:MM-HH:MM). Fuera de ella, la presencia es sospechosa
ACTIVE_HOURS=06:00-18:00

# Canal de notificación: console | telegram | email (telegram/email requieren implementación)
ALERT_CHANNEL=console

# Segundos mínimos entre alertas de la misma zona (evita saturación)
ALERT_COOLDOWN=60

# Modelo de detección (se descarga automáticamente la primera vez)
MODEL_PATH=yolov8n.pt

# Procesar 1 de cada N frames (reduce consumo de CPU)
FRAME_SKIP=5
